        </parameter>
        <parameter>
            <name>sigma_DSS_6</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_DSS_6_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_DSS_6_target</name>
            <type>Constant</type>
            <value>5.81e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_7</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_DSS_7_target</parameter>
