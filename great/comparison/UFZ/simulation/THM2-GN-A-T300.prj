            <type>Constant</type>
            <value>9.975e+06</value>
        </parameter>
    </parameters>
    <curves>
        <curve>
            <name>load_ramp</name>
            <coords>0 1800 5600</coords>
            <values>0 1 1</values>
        </curve>
    </curves>
    <process_variables>
        <process_variable>
            <name>temperature</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>T0</initial_condition>
            <!-- adiabatic outer perimeter (no BC); 15 degC at the inlet only during inflow -->
            <boundary_conditions>
                <boundary_condition>
                    <mesh>center</mesh>
                    <type>DirichletWithinTimeInterval</type>
                    <parameter>T_inj</parameter>
                    <time_interval>
                        <start>2000.5</start>
                        <end>5600</end>
                    </time_interval>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>zero</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>outer_boundary</mesh>
                    <type>Dirichlet</type>
                    <parameter>zero</parameter>
                </boundary_condition>
            </boundary_conditions>
            <source_terms>
                <source_term>
                    <mesh>center</mesh>
                    <type>Nodal</type>
                    <parameter>Q_inj</parameter>
                </source_term>
            </source_terms>
        </process_variable>
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>2</order>
            <initial_condition>u0</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>fix_bottom</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>zero</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>fix_bottom</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>zero</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>fix_left</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>zero</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_1</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_1</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_2</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_2</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_3</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_3</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_4</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_4</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_5</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_5</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_6</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_6</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_7</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_7</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_8</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_8</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_1</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_1</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_2</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_2</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_3</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_3</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_4</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_4</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_5</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_5</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_6</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_6</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_7</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_7</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_8</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_8</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver>
            <name>basic_newton</name>
            <type>Newton</type>
            <max_iter>20</max_iter>
            <linear_solver>general_linear_solver</linear_solver>
        </nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver>
            <name>general_linear_solver</name>
            <eigen>
                <solver_type>SparseLU</solver_type>
                <scaling>true</scaling>
            </eigen>
        </linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
