    </media>
    <time_loop>
        <processes>
            <process ref="THM">
                <nonlinear_solver>basic_newton</nonlinear_solver>
                <convergence_criterion>
                    <type>PerComponentDeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstols>1e-3 1e1 1e-8 1e-8</abstols>
                </convergence_criterion>
                <time_discretization>
                    <type>BackwardEuler</type>
                </time_discretization>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0</t_initial>
                    <t_end>5600</t_end>
                    <timesteps>
                        <!-- load ramp and hold 0 ... 2000 s -->
                        <pair>
                            <repeat>200</repeat>
                            <delta_t>10</delta_t>
                        </pair>
                        <!-- injection ramp 2000 ... 2120 s -->
                        <pair>
                            <repeat>120</repeat>
                            <delta_t>1</delta_t>
                        </pair>
                        <!-- constant injection 2120 ... 5600 s -->
                        <pair>
                            <repeat>696</repeat>
                            <delta_t>5</delta_t>
                        </pair>
                    </timesteps>
                </time_stepping>
            </process>
        </processes>
        <outputs>
            <output>
                <type>VTK</type>
                <prefix>THM2-GN-A-T300_{:meshname}</prefix>
                <meshes>
                    <mesh>domain</mesh>
                </meshes>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <each_steps>100000</each_steps>
                    </pair>
                </timesteps>
                <fixed_output_times>2000 2060 3800 5600</fixed_output_times>
                <variables>
                    <variable>temperature</variable>
                    <variable>pressure</variable>
                    <variable>displacement</variable>
                    <variable>sigma</variable>
                    <variable>epsilon</variable>
                    <variable>darcy_velocity</variable>
                </variables>
                <suffix>_ts_{:timestep}_t_{:time}</suffix>
            </output>
            <output>
                <type>VTK</type>
                <prefix>THM2-GN-A-T300_{:meshname}</prefix>
                <meshes>
                    <mesh>center</mesh>
                    <mesh>probe_circle</mesh>
                </meshes>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <each_steps>1</each_steps>
                    </pair>
                </timesteps>
                <variables>
                    <variable>temperature</variable>
                    <variable>pressure</variable>
                    <variable>displacement</variable>
                    <variable>sigma</variable>
                    <variable>epsilon</variable>
                </variables>
                <suffix>_ts_{:timestep}_t_{:time}</suffix>
            </output>
        </outputs>
    </time_loop>
    <parameters>
        <parameter>
            <name>E_rock</name>
            <type>Constant</type>
            <value>8.39e+10</value>
        </parameter>
        <parameter>
            <name>nu_rock</name>
            <type>Constant</type>
            <value>0.21</value>
        </parameter>
        <parameter>
            <name>T0</name>
            <type>Constant</type>
            <value>573.15</value>
        </parameter>
        <parameter>
            <name>u0</name>
            <type>Constant</type>
            <values>0 0</values>
        </parameter>
        <parameter>
            <name>zero</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>T_inj</name>
            <type>Constant</type>
            <value>288.15</value>
        </parameter>
        <parameter>
            <name>Q_inj</name>
            <type>Function</type>
            <!-- Table 8: Q2D = 8.333e-09 m3/s per m -> mass rate rho_w * Q2D; linear ramp 2000-2120 s -->
            <expression>(t &lt;= 2000) ? 0 : ((t &lt; 2120) ? 8.33333e-06*(t-2000)/120 : 8.33333e-06)</expression>
        </parameter>
        <parameter>
            <name>sigma_PEE_1</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_1_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_1_target</name>
            <type>Constant</type>
            <value>1e+07</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_2</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_2_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_2_target</name>
            <type>Constant</type>
            <value>6.64e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_3</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_3_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_3_target</name>
            <type>Constant</type>
            <value>4.46e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_4</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_4_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_4_target</name>
            <type>Constant</type>
            <value>1.17e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_5</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_5_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_5_target</name>
            <type>Constant</type>
            <value>1e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_6</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_6_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_6_target</name>
            <type>Constant</type>
            <value>3.82e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_7</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_7_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_7_target</name>
            <type>Constant</type>
            <value>7.8e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_8</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_PEE_8_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_PEE_8_target</name>
            <type>Constant</type>
            <value>9.95e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_1</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_DSS_1_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_DSS_1_target</name>
            <type>Constant</type>
            <value>8.32e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_2</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_DSS_2_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_DSS_2_target</name>
            <type>Constant</type>
            <value>5.55e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_3</name>
            <type>CurveScaled</type>
            <curve>load_ramp</curve>
            <parameter>sigma_DSS_3_target</parameter>
        </parameter>
        <parameter>
            <name>sigma_DSS_3_target</name>
