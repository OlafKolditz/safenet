<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  GREAT cell THM benchmark, Scenario II of the GREAT Cell Modelling Specification v2 (22.11.2026)
  Case THM2-GN-A-T300: gneiss, Load A, T0 = 300 degC, 2D plane strain (THERMO_HYDRO_MECHANICS)
  THM run, paired HM control: HM2-GN-A-T15

  Mesh   : make_great_cell_mesh.py (quadratic triangles; T, p order 1, u order 2)
           MaterialIDs 0 (r <= 0.097 m) and 1 (0.097...0.100 m) both rock: no rubber sheath
  Schedule (Table 8):
     0 - 1800 s : linear ramp of Load A (Table 3, DSS = mean of the neighbouring PEE)
      PEE 1 & 1a : 10.00 MPa    DSS 1 & 1a :  8.320 MPa
      PEE 2 & 2a :  6.64 MPa    DSS 2 & 2a :  5.550 MPa
      PEE 3 & 3a :  4.46 MPa    DSS 3 & 3a :  2.815 MPa
      PEE 4 & 4a :  1.17 MPa    DSS 4 & 4a :  1.085 MPa
      PEE 5 & 5a :  1.00 MPa    DSS 5 & 5a :  2.410 MPa
      PEE 6 & 6a :  3.82 MPa    DSS 6 & 6a :  5.810 MPa
      PEE 7 & 7a :  7.80 MPa    DSS 7 & 7a :  8.875 MPa
      PEE 8 & 8a :  9.95 MPa    DSS 8 & 8a :  9.975 MPa
  1800 - 2000 s : hold, Q = 0
  2000 - 2120 s : Q linear 0 -> Q0, T_in = 15 degC at the centre node
  2120 - 5600 s : Q = Q0, T_in = 15 degC
     Q0 = 0.1 ml/min = 1.667e-09 m3/s; Q2D = Q0/B = 8.333e-09 m3/s per m (B = 0.2 m)
     -> mass rate 8.333e-06 kg/s per m (equation_balance_type = mass)
  BC/IC (Table 9): T0 = 573.15 K uniform (T_ref = T0), adiabatic perimeter;
     p0 = 0 (gauge), p = 0 on the perimeter; u = 0, zero initial stress
  Rock (Table 2/6): E = 83.9 GPa, nu = 0.21, Biot = 0.6, porosity = 0.001,
     rho_s = 2750 kg/m3, k = 1e-19 m2, lambda_s = 3 W/(m K),
     c_s = 800 J/(kg K), alpha_s = 7e-06 1/K
  Water (Table 4/7): rho(T), mu(T), c(T) from IAPWS-IF97 fits (p_abs ~ 8.6 MPa), beta_f = -1/rho drho/dT, c_f = 0,
     lambda_f = 0.6 W/(m K)
  No rubber sheath (spec v2, Scenario II): MaterialIDs 1 has the rock properties
-->
<OpenGeoSysProject>
    <meshes>
        <mesh>domain.vtu</mesh>
        <mesh>PEE_1.vtu</mesh>
        <mesh>PEE_2.vtu</mesh>
        <mesh>PEE_3.vtu</mesh>
        <mesh>PEE_4.vtu</mesh>
        <mesh>PEE_5.vtu</mesh>
        <mesh>PEE_6.vtu</mesh>
        <mesh>PEE_7.vtu</mesh>
        <mesh>PEE_8.vtu</mesh>
        <mesh>DSS_1.vtu</mesh>
        <mesh>DSS_2.vtu</mesh>
        <mesh>DSS_3.vtu</mesh>
        <mesh>DSS_4.vtu</mesh>
        <mesh>DSS_5.vtu</mesh>
        <mesh>DSS_6.vtu</mesh>
        <mesh>DSS_7.vtu</mesh>
        <mesh>DSS_8.vtu</mesh>
        <mesh>outer_boundary.vtu</mesh>
        <mesh>fix_bottom.vtu</mesh>
        <mesh>fix_left.vtu</mesh>
        <mesh>center.vtu</mesh>
        <mesh>probe_circle.vtu</mesh>
    </meshes>
    <processes>
        <process>
            <name>THM</name>
            <type>THERMO_HYDRO_MECHANICS</type>
            <integration_order>4</integration_order>
            <constitutive_relation id="0">
                <type>LinearElasticIsotropic</type>
                <youngs_modulus>E_rock</youngs_modulus>
                <poissons_ratio>nu_rock</poissons_ratio>
            </constitutive_relation>
            <constitutive_relation id="1">
                <type>LinearElasticIsotropic</type>
                <youngs_modulus>E_rock</youngs_modulus>
                <poissons_ratio>nu_rock</poissons_ratio>
            </constitutive_relation>
            <process_variables>
                <temperature>temperature</temperature>
                <pressure>pressure</pressure>
                <displacement>displacement</displacement>
            </process_variables>
            <equation_balance_type>mass</equation_balance_type>
            <specific_body_force>0 0</specific_body_force>
            <secondary_variables>
                <secondary_variable internal_name="sigma" output_name="sigma"/>
                <secondary_variable internal_name="epsilon" output_name="epsilon"/>
                <secondary_variable internal_name="velocity" output_name="darcy_velocity"/>
            </secondary_variables>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Function</type>
                            <value>
                                <expression>(-4.92318707e-08)*(temperature-273.15)^4 + (2.66626666e-05)*(temperature-273.15)^3 + (-0.00707790348)*(temperature-273.15)^2 + (0.0813185288)*(temperature-273.15)^1 + (1003.62286)</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>(-1.969274828e-07)*(temperature-273.15)^3 + (7.99879998e-05)*(temperature-273.15)^2 + (-0.01415580696)*(temperature-273.15)^1 + (0.0813185288)</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>viscosity</name>
                            <type>Function</type>
                            <value>
                                <expression>1e-3*exp(-3.7188 + 578.919/(temperature - 137.546))</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>-578.919/((temperature - 137.546)^2)*1e-3*exp(-3.7188 + 578.919/(temperature - 137.546))</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Function</type>
                            <value>
                                <expression>(8.82625568e-07)*(temperature-273.15)^4 + (-0.000400672296)*(temperature-273.15)^3 + (0.0707378018)*(temperature-273.15)^2 + (-4.06898771)*(temperature-273.15)^1 + (4220.46309)</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>(3.530502272e-06)*(temperature-273.15)^3 + (-0.001202016888)*(temperature-273.15)^2 + (0.1414756036)*(temperature-273.15)^1 + (-4.06898771)</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>0.6</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Function</type>
                            <value>
                                <expression>-((-1.969274828e-07)*(temperature-273.15)^3 + (7.99879998e-05)*(temperature-273.15)^2 + (-0.01415580696)*(temperature-273.15)^1 + (0.0813185288))/((-4.92318707e-08)*(temperature-273.15)^4 + (2.66626666e-05)*(temperature-273.15)^3 + (-0.00707790348)*(temperature-273.15)^2 + (0.0813185288)*(temperature-273.15)^1 + (1003.62286))</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>0</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                    </properties>
                </phase>
                <phase>
                    <type>Solid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Constant</type>
                            <value>2750</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>3</value>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>800</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Constant</type>
                            <value>7e-06</value>
                        </property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property>
                    <name>permeability</name>
                    <type>Constant</type>
                    <value>1e-19</value>
                </property>
                <property>
                    <name>porosity</name>
                    <type>Constant</type>
                    <value>0.001</value>
                </property>
                <property>
                    <name>biot_coefficient</name>
                    <type>Constant</type>
                    <value>0.6</value>
                </property>
                <property>
                    <name>thermal_conductivity</name>
                    <type>EffectiveThermalConductivityPorosityMixing</type>
                </property>
            </properties>
        </medium>
        <medium id="1">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Function</type>
                            <value>
                                <expression>(-4.92318707e-08)*(temperature-273.15)^4 + (2.66626666e-05)*(temperature-273.15)^3 + (-0.00707790348)*(temperature-273.15)^2 + (0.0813185288)*(temperature-273.15)^1 + (1003.62286)</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>(-1.969274828e-07)*(temperature-273.15)^3 + (7.99879998e-05)*(temperature-273.15)^2 + (-0.01415580696)*(temperature-273.15)^1 + (0.0813185288)</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>viscosity</name>
                            <type>Function</type>
                            <value>
                                <expression>1e-3*exp(-3.7188 + 578.919/(temperature - 137.546))</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>-578.919/((temperature - 137.546)^2)*1e-3*exp(-3.7188 + 578.919/(temperature - 137.546))</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Function</type>
                            <value>
                                <expression>(8.82625568e-07)*(temperature-273.15)^4 + (-0.000400672296)*(temperature-273.15)^3 + (0.0707378018)*(temperature-273.15)^2 + (-4.06898771)*(temperature-273.15)^1 + (4220.46309)</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>(3.530502272e-06)*(temperature-273.15)^3 + (-0.001202016888)*(temperature-273.15)^2 + (0.1414756036)*(temperature-273.15)^1 + (-4.06898771)</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>0.6</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Function</type>
                            <value>
                                <expression>-((-1.969274828e-07)*(temperature-273.15)^3 + (7.99879998e-05)*(temperature-273.15)^2 + (-0.01415580696)*(temperature-273.15)^1 + (0.0813185288))/((-4.92318707e-08)*(temperature-273.15)^4 + (2.66626666e-05)*(temperature-273.15)^3 + (-0.00707790348)*(temperature-273.15)^2 + (0.0813185288)*(temperature-273.15)^1 + (1003.62286))</expression>
                            </value>
                            <dvalue>
                                <variable_name>temperature</variable_name>
                                <expression>0</expression>
                            </dvalue>
                            <dvalue>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <expression>0</expression>
                            </dvalue>
                        </property>
                    </properties>
                </phase>
                <phase>
                    <type>Solid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Constant</type>
                            <value>2750</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>3</value>
