<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  GREAT cell THM model - greywacke, Load A, 2D plane strain (THERMO_HYDRO_MECHANICS)
  = M model (benchmark M1, Mollaali et al. 2026, JRMGE, doi:10.1016/j.jrmge.2026.03.060)
  + TH model (TH_granite_injection.prj: heating, injection, shut-in)

  Mesh   : make_great_cell_mesh.py (quadratic triangles; T, p order 1, u order 2;
           h = 1.5 mm at the centre -> 6 mm at r = 0.065 m, 2 mm in the sheath)
           rock r <= 0.097 m (MaterialIDs 0), rubber sheath 0.097...0.100 m (MaterialIDs 1)
  Phase 0 (t = 0)          : mechanical Load A applied in the first time step
                             (normal stress on PEE's, Table 4; DSS's = mean of neighbours, Eq. 19):
      PEE 1 & 1a : 10.00 MPa    DSS 1 & 1a :  8.320 MPa
      PEE 2 & 2a :  6.64 MPa    DSS 2 & 2a :  5.550 MPa
      PEE 3 & 3a :  4.46 MPa    DSS 3 & 3a :  2.815 MPa
      PEE 4 & 4a :  1.17 MPa    DSS 4 & 4a :  1.085 MPa
      PEE 5 & 5a :  1.00 MPa    DSS 5 & 5a :  2.410 MPa
      PEE 6 & 6a :  3.82 MPa    DSS 6 & 6a :  5.810 MPa
      PEE 7 & 7a :  7.80 MPa    DSS 7 & 7a :  8.875 MPa
      PEE 8 & 8a :  9.95 MPa    DSS 8 & 8a :  9.975 MPa
  Phase 1 (0 ... 4000 s)   : outer boundary T ramp 293 -> 363 K (0...325 s), then 363 K
  Phase 2 (4000 ... 4050 s): injection at the centre node, Q = 1 l/min = 1.6667e-5 m3/s per m
                             (mass rate 1.6667e-2 kg/s per m, equation_balance_type = mass),
                             T_inj = 293 K (Dirichlet on the centre node)
  Phase 3 (4050 ... 5000 s): shut-in
  Hydraulic BC : p = p0 = 1 MPa on the outer boundary (drained)
  Initial      : T0 = 293 K, p0 = 1 MPa, u = 0, initial effective stress alpha*p0 so that the
                 initial state (p = p0, no load) is stress free in terms of total stress

  Rock (greywacke, Table 1): E = 26.85 GPa, nu = 0.27, Biot alpha = 0.8,
                 porosity = 0.005, rho_s = 2650 kg/m3
  Sheath (Table 1): E = 0.1 GPa, nu = 0.4, Biot alpha = 0
  Fluid  : rho = 1000 kg/m3 at p0, compressibility 4.4e-10 1/Pa (Table 3), mu = 1e-3 Pa s,
           c = 4180 J/(kg K), lambda = 0.6 W/(m K), no thermal expansion (as in the TH model)
  From TH model: k = 1.409e-14 m2 (rock and sheath); bulk lambda = 2.8 W/(m K) and
           bulk rho*c = 2700*790 J/(m3 K) in rock and sheath
           -> rock  : lambda_s = 2.8111, c_s = 801.02
           -> sheath: lambda_s = 2.8111, c_s = 1768.9
  Assumptions: linear thermal expansion coefficient of the solid 8e-06 1/K (rock and sheath);
           sheath hydraulically and thermally like the rock (drained boundary as in the TH model);
           PEE arc 18 deg, DSS arc 4.5 deg; no gravity
-->
<OpenGeoSysProject>
    <meshes>
        <mesh>domain.vtu</mesh>
        <mesh>PEE_1.vtu</mesh>
        <mesh>PEE_2.vtu</mesh>
        <mesh>PEE_3.vtu</mesh>
        <mesh>PEE_4.vtu</mesh>
        <mesh>PEE_5.vtu</mesh>
        <mesh>PEE_6.vtu</mesh>
        <mesh>PEE_7.vtu</mesh>
        <mesh>PEE_8.vtu</mesh>
        <mesh>DSS_1.vtu</mesh>
        <mesh>DSS_2.vtu</mesh>
        <mesh>DSS_3.vtu</mesh>
        <mesh>DSS_4.vtu</mesh>
        <mesh>DSS_5.vtu</mesh>
        <mesh>DSS_6.vtu</mesh>
        <mesh>DSS_7.vtu</mesh>
        <mesh>DSS_8.vtu</mesh>
        <mesh>outer_boundary.vtu</mesh>
        <mesh>fix_bottom.vtu</mesh>
        <mesh>fix_left.vtu</mesh>
        <mesh>center.vtu</mesh>
        <mesh>probe_circle.vtu</mesh>
    </meshes>
    <processes>
        <process>
            <name>THM</name>
            <type>THERMO_HYDRO_MECHANICS</type>
            <integration_order>4</integration_order>
            <constitutive_relation id="0">
                <type>LinearElasticIsotropic</type>
                <youngs_modulus>E_rock</youngs_modulus>
                <poissons_ratio>nu_rock</poissons_ratio>
            </constitutive_relation>
            <constitutive_relation id="1">
                <type>LinearElasticIsotropic</type>
                <youngs_modulus>E_sheath</youngs_modulus>
                <poissons_ratio>nu_sheath</poissons_ratio>
            </constitutive_relation>
            <process_variables>
                <temperature>temperature</temperature>
                <pressure>pressure</pressure>
                <displacement>displacement</displacement>
            </process_variables>
            <!-- mass balance: needed for the pressure-dependent fluid density (compressibility);
                 the injection source term is therefore a mass rate [kg/s per m] -->
            <equation_balance_type>mass</equation_balance_type>
            <initial_stress>sigma0</initial_stress>
            <specific_body_force>0 0</specific_body_force>
            <secondary_variables>
                <secondary_variable internal_name="sigma" output_name="sigma"/>
                <secondary_variable internal_name="epsilon" output_name="epsilon"/>
                <secondary_variable internal_name="velocity" output_name="darcy_velocity"/>
            </secondary_variables>
        </process>
    </processes>
    <media>
        <medium id="0">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Linear</type>
                            <reference_value>1000</reference_value>
                            <independent_variable>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <reference_condition>1e+06</reference_condition>
                                <slope>4.4e-10</slope>
                            </independent_variable>
                        </property>
                        <property>
                            <name>viscosity</name>
                            <type>Constant</type>
                            <value>0.001</value>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>4180</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>0.6</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Constant</type>
                            <value>0</value>
                        </property>
                    </properties>
                </phase>
                <phase>
                    <type>Solid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Constant</type>
                            <value>2650</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>2.81106</value>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>801.024</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Constant</type>
                            <value>8e-06</value>
                        </property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property>
                    <name>permeability</name>
                    <type>Constant</type>
                    <value>1.409e-14</value>
                </property>
                <property>
                    <name>porosity</name>
                    <type>Constant</type>
                    <value>0.005</value>
                </property>
                <property>
                    <name>biot_coefficient</name>
                    <type>Constant</type>
                    <value>0.8</value>
                </property>
                <property>
                    <name>thermal_conductivity</name>
                    <type>EffectiveThermalConductivityPorosityMixing</type>
                </property>
            </properties>
        </medium>
        <medium id="1">
            <phases>
                <phase>
                    <type>AqueousLiquid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Linear</type>
                            <reference_value>1000</reference_value>
                            <independent_variable>
                                <variable_name>liquid_phase_pressure</variable_name>
                                <reference_condition>1e+06</reference_condition>
                                <slope>4.4e-10</slope>
                            </independent_variable>
                        </property>
                        <property>
                            <name>viscosity</name>
                            <type>Constant</type>
                            <value>0.001</value>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>4180</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>0.6</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Constant</type>
                            <value>0</value>
                        </property>
                    </properties>
                </phase>
                <phase>
                    <type>Solid</type>
                    <properties>
                        <property>
                            <name>density</name>
                            <type>Constant</type>
                            <value>1200</value>
                        </property>
                        <property>
                            <name>thermal_conductivity</name>
                            <type>Constant</type>
                            <value>2.81106</value>
                        </property>
                        <property>
                            <name>specific_heat_capacity</name>
                            <type>Constant</type>
                            <value>1768.93</value>
                        </property>
                        <property>
                            <name>thermal_expansivity</name>
                            <type>Constant</type>
                            <value>8e-06</value>
                        </property>
                    </properties>
                </phase>
            </phases>
            <properties>
                <property>
                    <name>permeability</name>
                    <type>Constant</type>
                    <value>1.409e-14</value>
                </property>
                <property>
                    <name>porosity</name>
                    <type>Constant</type>
                    <value>0.005</value>
                </property>
                <property>
                    <name>biot_coefficient</name>
                    <type>Constant</type>
                    <value>0</value>
                </property>
                <property>
                    <name>thermal_conductivity</name>
                    <type>EffectiveThermalConductivityPorosityMixing</type>
                </property>
            </properties>
        </medium>
    </media>
    <time_loop>
        <processes>
            <process ref="THM">
                <nonlinear_solver>basic_newton</nonlinear_solver>
                <convergence_criterion>
                    <type>PerComponentDeltaX</type>
                    <norm_type>NORM2</norm_type>
                    <abstols>1e-1 1e1 1e-7 1e-7</abstols>
                </convergence_criterion>
                <time_discretization>
                    <type>BackwardEuler</type>
                </time_discretization>
                <time_stepping>
                    <type>FixedTimeStepping</type>
                    <t_initial>0</t_initial>
                    <t_end>5000</t_end>
                    <timesteps>
                        <!-- ramp of the boundary temperature 0 ... 400 s -->
                        <pair>
                            <repeat>80</repeat>
                            <delta_t>5</delta_t>
                        </pair>
                        <!-- heating 400 ... 4000 s -->
                        <pair>
                            <repeat>90</repeat>
                            <delta_t>40</delta_t>
                        </pair>
                        <!-- injection 4000 ... 4050 s -->
                        <pair>
                            <repeat>50</repeat>
                            <delta_t>1</delta_t>
                        </pair>
                        <!-- early shut-in 4050 ... 4150 s -->
                        <pair>
                            <repeat>50</repeat>
                            <delta_t>2</delta_t>
                        </pair>
                        <!-- recovery 4150 ... 5000 s -->
                        <pair>
                            <repeat>85</repeat>
                            <delta_t>10</delta_t>
                        </pair>
                    </timesteps>
                </time_stepping>
            </process>
        </processes>
        <outputs>
            <output>
                <type>VTK</type>
                <prefix>THM_greywacke_loadA_{:meshname}</prefix>
                <meshes>
                    <mesh>domain</mesh>
                </meshes>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <each_steps>100000</each_steps>
                    </pair>
                </timesteps>
                <fixed_output_times>5 325 2000 4000 4001 4005 4010 4025 4050 4060 4100 4200 4500 5000</fixed_output_times>
                <variables>
                    <variable>temperature</variable>
                    <variable>pressure</variable>
                    <variable>displacement</variable>
                    <variable>sigma</variable>
                    <variable>epsilon</variable>
                    <variable>darcy_velocity</variable>
                </variables>
                <suffix>_ts_{:timestep}_t_{:time}</suffix>
            </output>
            <output>
                <type>VTK</type>
                <prefix>THM_greywacke_loadA_{:meshname}</prefix>
                <meshes>
                    <mesh>center</mesh>
                    <mesh>probe_circle</mesh>
                </meshes>
                <timesteps>
                    <pair>
                        <repeat>1</repeat>
                        <each_steps>1</each_steps>
                    </pair>
                </timesteps>
                <variables>
                    <variable>temperature</variable>
                    <variable>pressure</variable>
                    <variable>displacement</variable>
                    <variable>sigma</variable>
                    <variable>epsilon</variable>
                </variables>
                <suffix>_ts_{:timestep}_t_{:time}</suffix>
            </output>
        </outputs>
    </time_loop>
    <parameters>
        <parameter>
            <name>E_rock</name>
            <type>Constant</type>
            <value>2.685e+10</value>
        </parameter>
        <parameter>
            <name>nu_rock</name>
            <type>Constant</type>
            <value>0.27</value>
        </parameter>
        <parameter>
            <name>E_sheath</name>
            <type>Constant</type>
            <value>1e+08</value>
        </parameter>
        <parameter>
            <name>nu_sheath</name>
            <type>Constant</type>
            <value>0.4</value>
        </parameter>
        <!-- initial effective stress alpha*p0 (rock) / 0 (sheath, alpha = 0): zero total stress at p = p0 -->
        <parameter>
            <name>sigma0</name>
            <type>Group</type>
            <group_id_property>MaterialIDs</group_id_property>
            <index_values>
                <index>0</index>
                <values>800000 800000 800000 0</values>
            </index_values>
            <index_values>
                <index>1</index>
                <values>0 0 0 0</values>
            </index_values>
        </parameter>
        <parameter>
            <name>T0</name>
            <type>Constant</type>
            <value>293</value>
        </parameter>
        <parameter>
            <name>p0</name>
            <type>Constant</type>
            <value>1e+06</value>
        </parameter>
        <parameter>
            <name>u0</name>
            <type>Constant</type>
            <values>0 0</values>
        </parameter>
        <parameter>
            <name>zero</name>
            <type>Constant</type>
            <value>0</value>
        </parameter>
        <parameter>
            <name>one</name>
            <type>Constant</type>
            <value>1</value>
        </parameter>
        <parameter>
            <name>T_outer</name>
            <type>CurveScaled</type>
            <curve>T_outer_curve</curve>
            <parameter>one</parameter>
        </parameter>
        <parameter>
            <name>T_inj</name>
            <type>Constant</type>
            <value>293</value>
        </parameter>
        <parameter>
            <name>Q_inj</name>
            <type>Function</type>
            <!-- 1 l/min = 1.66667e-05 m3/s per m  ->  mass rate rho_w * Q -->
            <expression>(t &gt; 4000 and t &lt;= 4050) ? 0.0166667 : 0</expression>
        </parameter>
        <parameter>
            <name>sigma_PEE_1</name>
            <type>Constant</type>
            <value>1e+07</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_2</name>
            <type>Constant</type>
            <value>6.64e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_3</name>
            <type>Constant</type>
            <value>4.46e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_4</name>
            <type>Constant</type>
            <value>1.17e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_5</name>
            <type>Constant</type>
            <value>1e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_6</name>
            <type>Constant</type>
            <value>3.82e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_7</name>
            <type>Constant</type>
            <value>7.8e+06</value>
        </parameter>
        <parameter>
            <name>sigma_PEE_8</name>
            <type>Constant</type>
            <value>9.95e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_1</name>
            <type>Constant</type>
            <value>8.32e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_2</name>
            <type>Constant</type>
            <value>5.55e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_3</name>
            <type>Constant</type>
            <value>2.815e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_4</name>
            <type>Constant</type>
            <value>1.085e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_5</name>
            <type>Constant</type>
            <value>2.41e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_6</name>
            <type>Constant</type>
            <value>5.81e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_7</name>
            <type>Constant</type>
            <value>8.875e+06</value>
        </parameter>
        <parameter>
            <name>sigma_DSS_8</name>
            <type>Constant</type>
            <value>9.975e+06</value>
        </parameter>
    </parameters>
    <curves>
        <curve>
            <name>T_outer_curve</name>
            <coords>0 325 5000</coords>
            <values>293 363 363</values>
        </curve>
    </curves>
    <process_variables>
        <process_variable>
            <name>temperature</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>T0</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>outer_boundary</mesh>
                    <type>Dirichlet</type>
                    <parameter>T_outer</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>center</mesh>
                    <type>DirichletWithinTimeInterval</type>
                    <parameter>T_inj</parameter>
                    <time_interval>
                        <start>4000.5</start>
                        <end>4050</end>
                    </time_interval>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
        <process_variable>
            <name>pressure</name>
            <components>1</components>
            <order>1</order>
            <initial_condition>p0</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>outer_boundary</mesh>
                    <type>Dirichlet</type>
                    <parameter>p0</parameter>
                </boundary_condition>
            </boundary_conditions>
            <source_terms>
                <source_term>
                    <mesh>center</mesh>
                    <type>Nodal</type>
                    <parameter>Q_inj</parameter>
                </source_term>
            </source_terms>
        </process_variable>
        <process_variable>
            <name>displacement</name>
            <components>2</components>
            <order>2</order>
            <initial_condition>u0</initial_condition>
            <boundary_conditions>
                <boundary_condition>
                    <mesh>fix_bottom</mesh>
                    <type>Dirichlet</type>
                    <component>0</component>
                    <parameter>zero</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>fix_bottom</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>zero</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>fix_left</mesh>
                    <type>Dirichlet</type>
                    <component>1</component>
                    <parameter>zero</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_1</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_1</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_2</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_2</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_3</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_3</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_4</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_4</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_5</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_5</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_6</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_6</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_7</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_7</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>PEE_8</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_PEE_8</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_1</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_1</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_2</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_2</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_3</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_3</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_4</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_4</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_5</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_5</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_6</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_6</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_7</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_7</parameter>
                </boundary_condition>
                <boundary_condition>
                    <mesh>DSS_8</mesh>
                    <type>NormalTraction</type>
                    <parameter>sigma_DSS_8</parameter>
                </boundary_condition>
            </boundary_conditions>
        </process_variable>
    </process_variables>
    <nonlinear_solvers>
        <nonlinear_solver>
            <name>basic_newton</name>
            <type>Newton</type>
            <max_iter>20</max_iter>
            <linear_solver>general_linear_solver</linear_solver>
        </nonlinear_solver>
    </nonlinear_solvers>
    <linear_solvers>
        <linear_solver>
            <name>general_linear_solver</name>
            <eigen>
                <solver_type>SparseLU</solver_type>
                <scaling>true</scaling>
            </eigen>
        </linear_solver>
    </linear_solvers>
</OpenGeoSysProject>
